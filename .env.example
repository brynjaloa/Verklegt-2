DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=5432
DB_SSLMODE=require

# Optional: enable shared uploaded images through Azure Blob Storage.
# If these are not set, Django stores uploaded files locally in media/.
AZURE_ACCOUNT_NAME=your_storage_account_name
AZURE_ACCOUNT_KEY=your_storage_account_key
AZURE_CONTAINER=media
AZURE_CUSTOM_DOMAIN=
